# Backend production example environment variables
# Copy this to backend/.env.production and populate secrets in Render/GitHub

# Database (use managed Postgres)
DATABASE_URL=postgres://<user>:<pass>@<host>:5432/<db>

# Blockchain / Contracts
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
CHAIN_ID=11155111
VOTING_CONTRACT_ADDRESS=0x...            # Verified VotingSSI contract address on Sepolia
VERIFIER_ADDRESS=0x...                   # Verifier contract address

# Keys (store securely; do NOT commit)
RELAYER_PRIVATE_KEY=0x...
ADMIN_PRIVATE_KEY=0x...

# Server
PORT=5000
NODE_ENV=production
SESSION_SECRET=replace-with-secure-random

# SMTP (for production email delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM="SSI Voting <no-reply@example.com>"

# Feature flags
MOCK_BLOCKCHAIN=false
# =================================================================
# SSI VOTING - ENVIRONMENT VARIABLES TEMPLATE
# Kullanim: cp .env.example .env  (sonra degerleri duzelt)
# DIKKAT: .env dosyasini Git'e commit ETME!
# Production icin Render Dashboard > Environment'tan setle.
# =================================================================

# -- Blockchain ---------------------------------------------------
# Lokal: Hardhat test hesabi #0 (sadece dev). Production: Sepolia ozel anahtarini koy.
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Lokal: http://127.0.0.1:8545 | Sepolia: https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
RPC_URL=http://127.0.0.1:8545

# Deploy sonrasi otomatik doldurulur - ya da elle gir
VOTING_CONTRACT_ADDRESS=
SSI_CONTRACT_ADDRESS=

# Hardhat local: 31337 | Sepolia: 11155111
CHAIN_ID=31337

# -- Backend ------------------------------------------------------
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# JWT/Session: production'da MUTLAKA yeniden uret -> openssl rand -hex 48
JWT_SECRET=change_this_to_a_long_random_string_in_production
SESSION_SECRET=change_this_to_a_long_random_string_in_production
SESSION_TIMEOUT=28800000

# Persistent disk path (Render'da /var/data/database.db, lokalde bos birak)
# DB_PATH=/var/data/database.db

# -- CORS ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
FRONTEND_URL=http://localhost:3000

# -- Guvenlik -----------------------------------------------------
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
WALLET_ENCRYPTION_KEY=change_this_in_production

# -- SMTP (OTP icin) ---------------------------------------------
# Office365: app password kullan (https://account.microsoft.com/security)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
SMTP_FROM="SSI Voting <noreply@yourdomain.com>"

# Mail provider secimi: auto | resend | smtp
# - auto: RESEND_* varsa Resend, yoksa SMTP
# - resend: sadece Resend kullan (SMTP'ye dusmez)
# - smtp: sadece SMTP kullan
MAIL_PROVIDER=auto

# -- Resend API (SMTP yerine tavsiye edilen seçenek) ----------------
# RESEND_API_KEY set edilirse OTP e-postalari önce Resend API ile gönderilir.
# RESEND_FROM doğrulanmış sender olmalıdır (örn: SSI Voting <onboarding@resend.dev>).
RESEND_API_KEY=
RESEND_FROM=

# -- Debug (sadece gelistirme) ------------------------------------
DEBUG=false
MOCK_BLOCKCHAIN=false
DEBUG_OTP=false
SKIP_SIGNATURE_VERIFICATION=false